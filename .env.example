# Copy this file to backend/.env (or export these as real environment
# variables) for local development. Every value below is a PLACEHOLDER —
# never commit a real secret or production credential to this repo.
#
# The frontend only needs VITE_API_BASE_URL; everything else is read by
# the Spring Boot backend (see backend/src/main/resources/application.yml).

# --- Frontend (Vite) ---------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080

# --- Backend: database (PostgreSQL) ------------------------------------
# Local dev default points at a `pathos` database with a `pathos` role —
# set up your own local role/password; do not reuse this value anywhere
# but your own machine.
DB_URL=jdbc:postgresql://localhost:5432/pathos
DB_USERNAME=pathos
DB_PASSWORD=change-me-locally

# --- Backend: JWT --------------------------------------------------------
# Must be at least 32 bytes. Generate your own, e.g.:
#   openssl rand -base64 48
# NEVER reuse the insecure default baked into application.yml outside of
# local development — that default exists only so a fresh checkout runs.
JWT_SECRET=replace-with-a-real-random-32-byte-minimum-secret
JWT_EXPIRATION_MINUTES=60

# --- Backend: server / CORS ---------------------------------------------
SERVER_PORT=8080
# Comma-separated list of allowed origins. Never use "*" (wildcard).
CORS_ALLOWED_ORIGINS=http://localhost:5173
